# The summary numbers taken from them go into results/*.csv, which IS tracked.
results/traces/

# --- CPU smoke-test output (not benchmark results) ---
results/smoke/
*.pt.trace.json
*.pt.trace.json.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

